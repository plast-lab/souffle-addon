  , ["sat", nil]).
TestCase(["EQ", ["GT", ["0xa", nil, nil],["0x9", nil, nil]] , ["0x1", nil, nil]]
  , ["sat", nil]).
TestCase(["EQ", ["GT", ["0xa", nil, nil],["0xa", nil, nil]] , ["0x0", nil, nil]]
